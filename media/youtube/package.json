{
  "name": "@runtime-protocol/adapter-youtube",
  "version": "0.1.0",
  "description": "Runtime Protocol adapter: YouTube videos, comments, thumbnails and playlists through communication.publish and resource.*.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Company-Runtime/runtime-adapters.git",
    "directory": "media/youtube"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
